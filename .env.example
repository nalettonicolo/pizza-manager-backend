# Backend (server/pizzeria-backend/.env o variabili su Railway/Render)
# PORT=3000
# DATABASE_URL=postgresql://...
# JWT_SECRET=your-secret
# CORS_ORIGIN=https://tuo-frontend.web.app

# Frontend (root .env) – per build con Vite
# Super Admin: pannello test reparti (iframe multipli) + accesso route operative come superadmin
# VITE_ENABLE_TEST_REPARTI=true
#
# Abbonamenti: abilita il gate sui servizi (piano tenant + opz. parametri_operativi.servizi_abilitati).
# VITE_ENFORCE_SERVIZI_PLAN=true
# Disattiva il gate anche se ENFORCE è true (emergenza): VITE_DISABLE_SERVIZI_GATE=true
# VITE_DISABLE_SERVIZI_GATE=true
# Login staff se aperto per errore dal dominio pizzeria (redirect lato client)
# VITE_SAAS_APP_ORIGIN=https://pizzamanager.it
#
# VITE_API_URL=https://tuo-backend.railway.app
# VITE_SUPABASE_URL=https://xxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
#
# Supabase → Edge Functions → Secrets (produzione): STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL: https://<project>.supabase.co/functions/v1/payment-stripe-webhook
# Eventi consigliati: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
#
# API partner OAuth (oauth-token, api-v1-ordini — docs/API_OAUTH_STUB.md):
# npx supabase secrets set OAUTH_JWT_SECRET=<genera con: openssl rand -base64 48>
# Auto-assegnazione rider (delivery-assegna-ordine-auto): routing stradale OpenRouteService,
# fallback Haversine se assente/non risponde. Chiave gratuita su https://openrouteservice.org
# npx supabase secrets set ORS_API_KEY=<chiave openrouteservice.org>
# Diagnostica Supabase in console (log per ogni tentativo fallito su getTenants / fallback select)
# VITE_DEBUG_SUPABASE=true
#
# Errori frontend (opzionale; non inviare tenant_id/PII senza policy privacy e beforeSend)
# VITE_SENTRY_DSN=
# VITE_GOOGLE_MAPS_API_KEY=...
#
# Hostname aggiuntivi che montano il bundle completo (Landing, superadmin, /preview) come localhost/app.*
# — utile se fai hosting su un dominio che non è pizzamanager.it (es. altro progetto Firebase).
# VITE_FULL_APP_HOSTNAMES=mio-progetto.web.app
#
# Vetrina /preview e /negozio su dominio SaaS (localhost, app.*): quale tenant mostrare se non c’è ?tenant=<uuid>
# VITE_PUBLIC_DEMO_TENANT_ID=<uuid da Supabase>
# oppure slug (default cerca "demo"):
# VITE_PUBLIC_DEMO_TENANT_SLUG=demo
#
# Area cliente demo (ingresso Super Admin → «Area cliente»): login automatico Cliente Test
# VITE_DEMO_CLIENTE_EMAIL=info@pizzamanager.it
# VITE_DEMO_CLIENTE_PASSWORD=DemoCliente!2026
#
# Titolare per informative legali (privacy, cookie, termini) su pizzamanager.it — persona fisica / ditta
# VITE_LEGAL_TITOLARE_NOME=Mario Rossi
# VITE_LEGAL_TITOLARE_QUALIFICA=ditta individuale
# VITE_LEGAL_TITOLARE_INDIRIZZO=Via Esempio 1, 00100 Roma (RM)
# VITE_LEGAL_EMAIL_PRIVACY=privacy@pizzamanager.it
# VITE_LEGAL_EMAIL_INFO=info@pizzamanager.it
#
# Pubblicazione dominio cliente (Admin → Pubblicazione sito): testo guida DNS / target CNAME
# VITE_PUBLIC_DOMAIN_CNAME_TARGET=pizzamanager.it
# VITE_PUBLIC_SAAS_BASE_URL=https://pizzamanager.it
# VITE_PUBLIC_DOMAIN_FIREBASE_DOCS_URL=https://firebase.google.com/docs/hosting/custom-domain

# Docker Compose (root)
# DATABASE_URL=postgresql://...
# JWT_SECRET=your-secret
# CORS_ORIGIN=http://localhost
# VITE_SUPABASE_URL=...
# VITE_SUPABASE_ANON_KEY=...
# VITE_GOOGLE_MAPS_API_KEY=...
