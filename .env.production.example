# Copia come .env.production e compila prima di "npm run build"
# Non committare .env.production (è in .gitignore)
#
# Vite in produzione carica anche .env: se qui manca una variabile, può essere
# ereditata da .env locale (rischio localhost o http nel deploy). Preferisci
# valori Supabase pubblici sempre definiti anche in questo file.

# URL del backend Koyeb (senza slash finale) – obbligatorio per le chiamate API
VITE_API_URL=https://TUO-SERVIZIO.koyeb.app

# Da .env (stessi valori che usi in sviluppo)
# IMPORTANTE: su hosting HTTPS (Firebase / dominio custom) l'URL deve essere https://…supabase.co
# (se usi http:// il browser bloccherà le chiamate Auth con "Failed to fetch" / mixed content).
VITE_SUPABASE_URL=https://flfhrwzlrftuhkrfwzse.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_GOOGLE_MAPS_API_KEY=

# Anteprima /preview e /negozio su dominio SaaS (pizzamanager.it, localhost)
# UUID tenant da mostrare se non c'è ?tenant=<uuid> in URL
# VITE_PUBLIC_DEMO_TENANT_ID=95c0b10f-b677-4131-abd9-e60e8cf9e3bf
# oppure slug (default cerca "demo", poi primo tenant attivo):
# VITE_PUBLIC_DEMO_TENANT_SLUG=demo

# Opzionale — osservabilità checkout cassa (Blocco A4)
# VITE_SENTRY_DSN=https://…@….ingest.sentry.io/…
