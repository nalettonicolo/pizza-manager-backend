{
  "name": "pizza-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/promozioniCalendario.test.mjs",
    "test:unit": "vitest run",
    "test:vitest": "vitest",
    "test:all": "npm run test && npm run test:unit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.{js,mjs}\" \"vite.config.js\" \"eslint.config.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"tests/**/*.{js,mjs}\" \"vite.config.js\" \"eslint.config.js\"",
    "ci:frontend": "npm run lint && npm run test:all && npm run build",
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "check:live": "node scripts/check-live-index.mjs",
    "deploy:hosting": "npm run ci:frontend && npx firebase deploy --only hosting",
    "deploy:hosting:ci": "npm run ci:frontend && npx --yes firebase deploy --only hosting --non-interactive",
    "deploy:full:ci": "npm run deploy:hosting:ci",
    "deploy:push-then-hosting": "git push && npm run deploy:hosting",
    "deploy:push-then-hosting:ci": "git push && npm run deploy:hosting:ci",
    "deploy": "npm run deploy:hosting",
    "publish:hosting": "node scripts/publish.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.48.0",
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.1.0",
    "@supabase/supabase-js": "^2.95.3",
    "axios": "^1.7.9",
    "lucide-react": "^0.575.0",
    "prop-types": "^15.8.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitejs/plugin-react": "^4.2.0",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "firebase-tools": "^13.0.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "stripe": "^17.5.0",
    "supabase": "^2.76.12",
    "ts-node": "^10.9.2",
    "vite": "^7.3.1",
    "vitest": "^3.0.9"
  }
}
