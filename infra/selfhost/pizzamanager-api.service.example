# Esempio unit systemd per API Nest PizzaManager.
# 1) Adatta User, WorkingDirectory, EnvironmentFile ai percorsi del server.
# 2) In EnvironmentFile (es. /etc/pizzamanager/api.env) metti: PORT, DATABASE_URL, JWT_SECRET, CORS_ORIGIN, ecc. (stesso set di server/pizzeria-backend/.env)
# 3) sudo cp pizzamanager-api.service.example /etc/systemd/system/pizzamanager-api.service
# 4) Sul repo: cd server/pizzeria-backend && npm ci && npm run build
# 5) sudo systemctl daemon-reload && sudo systemctl enable --now pizzamanager-api
#
# Nest ascolta su PORT (default 3001 in questo progetto); Caddy/Nginx fanno reverse_proxy verso 127.0.0.1:3001.

[Unit]
Description=PizzaManager Nest API (pizzeria-backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pizzamanager
Group=pizzamanager
WorkingDirectory=/srv/pizzamanager/PizzaManagerApp/server/pizzeria-backend
EnvironmentFile=-/etc/pizzamanager/api.env
ExecStart=/usr/bin/node dist/main
Restart=on-failure
RestartSec=5

# Hardening opzionale (decommenta se compatibile col tuo deploy)
# NoNewPrivileges=true
# PrivateTmp=true

[Install]
WantedBy=multi-user.target
