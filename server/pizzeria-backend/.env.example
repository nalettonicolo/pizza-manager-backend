# Produzione: valori obbligatori, da configurare nella piattaforma di deploy.
NODE_ENV=production
PORT=8000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public
JWT_SECRET=replace-with-a-long-random-secret
# Lista separata da virgole di tutti i domini frontend autorizzati.
CORS_ORIGIN=https://pizzamanager.it
# Disabilitato per default. Attivarlo soltanto per ambienti interni controllati.
SWAGGER_ENABLED=false
