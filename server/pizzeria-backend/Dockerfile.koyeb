# Build stage (Node 22; NestJS 11 richiede almeno Node 20)
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma/
RUN npm install
RUN npx prisma generate

COPY . .
RUN npm run build

# Nest con tsconfig senza rootDir produce dist/src/main.js, non dist/main.js
RUN test -f /app/dist/src/main.js || (echo "ERRORE: dist/src/main.js non trovato dopo npm run build" && exit 1)

# Run stage: solo dist + dipendenze necessarie
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/prisma ./prisma

RUN test -f /app/dist/src/main.js || (echo "ERRORE: dist/src/main.js mancante nell'immagine finale" && exit 1)

EXPOSE 8000

# Entry point: Nest compila in dist/src/main.js
CMD ["node", "dist/src/main.js"]
